rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isFamily(familyId) {
      return request.auth != null && request.auth.uid == familyId;
    }

    function smallDoc() {
      return request.resource.data.keys().size() < 40;
    }

    // Everything lives under families/{familyId}; only that signed-in family may touch it.
    match /families/{familyId} {
      allow read: if isFamily(familyId);
      allow create, update: if isFamily(familyId) && smallDoc();
      allow delete: if false;

      match /profiles/{profileId} {
        allow read, delete: if isFamily(familyId);
        allow create, update: if isFamily(familyId)
          && smallDoc()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 20
          && request.resource.data.stars is int
          && request.resource.data.stars >= 0
          && request.resource.data.totalStarsEarned is int
          && request.resource.data.totalStarsEarned >= 0
          && request.resource.data.world in ['arena', 'garden'];
      }

      // Progress, SRS cards, sessions, inventory, cards, league, story, co-op, custom words.
      match /profiles/{profileId}/{sub}/{docId} {
        allow read, delete: if isFamily(familyId);
        allow create, update: if isFamily(familyId) && smallDoc();
      }

      match /customWords/{wordId} {
        allow read, delete: if isFamily(familyId);
        allow create, update: if isFamily(familyId) && smallDoc();
      }

      match /coop/{eventId} {
        allow read, delete: if isFamily(familyId);
        allow create, update: if isFamily(familyId) && smallDoc();
      }
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
